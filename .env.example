# Public, build-time configuration injected via Vite import.meta.env.
# Copy to .env.local and adjust as needed. These are PUBLIC client values
# only -- NO secrets (tokens, client secrets, API keys) belong in this file.

# Base URL of the gubbi API. Defaults to https://api.gubbi.ai when unset. Its
# host is an allowed outbound egress target (see src/lib/net/fetch.ts).
VITE_API_BASE_URL=https://api.gubbi.ai

# Host of the auth issuer. Accepts a bare host or a full URL. Defaults to
# auth.gubbi.ai when unset. Its host is the other allowed egress target.
VITE_AUTH_HOST=auth.gubbi.ai

# Public OAuth client id for the extension's authorization-code + PKCE flow.
# Mirrors the journal-web client (token_endpoint_auth_method none, PKCE S256).
# Defaults to journal-extension when unset. PUBLIC -- there is no client secret.
VITE_HYDRA_CLIENT_ID=journal-extension

# The Chrome extension key and the Firefox gecko id are permanent identities,
# committed as constants in scripts/browser-identity.mjs; they are not read
# from the environment.
