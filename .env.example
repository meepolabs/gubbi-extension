# Public, build-time configuration injected via Vite import.meta.env.
# Copy to .env.local and adjust as needed. These are PUBLIC client values
# only -- NO secrets (tokens, client secrets, API keys) belong in this file.

# A non-production artifact: set both endpoint values below to that
# deployment's hosts in .env.local, then run `pnpm verify && pnpm zip`. The
# manifest host_permissions and the egress allowlist both follow these values,
# and the verifier checks each manifest against them.

# Base URL of the gubbi API: an https origin or a bare DNS host (lowercase,
# punycode), with no port, credentials, path, query, fragment, wildcard,
# trailing dot or IP literal. Defaults to https://api.gubbi.ai when unset; an
# invalid (or empty) value fails the build instead of falling back. Its host is
# an allowed outbound egress target and a manifest host permission (see
# src/lib/net/endpoint-host.mjs).
VITE_API_BASE_URL=https://api.gubbi.ai

# Host of the auth issuer, in the same form as VITE_API_BASE_URL. Defaults to
# auth.gubbi.ai when unset; an invalid (or empty) value fails the build. Its
# host is the other allowed egress target and manifest host permission.
VITE_AUTH_HOST=auth.gubbi.ai

# Public OAuth client id for the extension's authorization-code + PKCE flow.
# Mirrors the journal-web client (token_endpoint_auth_method none, PKCE S256).
# Defaults to journal-extension when unset. PUBLIC -- there is no client secret.
VITE_HYDRA_CLIENT_ID=journal-extension

# The Chrome extension key and the Firefox gecko id are permanent identities,
# committed as constants in scripts/browser-identity.mjs; they are not read
# from the environment.
