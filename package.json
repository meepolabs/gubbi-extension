{
  "name": "gubbi-extension",
  "version": "0.1.0",
  "description": "Turn your AI chats into a searchable, structured diary. Cross-browser MV3 extension for gubbi.",
  "private": false,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "check": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "check-required-needs": "node --test scripts/verify-required-needs.test.mjs && node scripts/verify-required-needs.mjs",
    "test:scripts": "node --test scripts/extension-id.test.mjs scripts/host-permissions.test.mjs scripts/verify-manifest.test.mjs scripts/vitest-env.test.mjs",
    "verify": "pnpm format:check && pnpm check-required-needs && pnpm test:scripts && pnpm check && pnpm lint && pnpm test && pnpm build && node scripts/verify-manifest.mjs"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.1.43",
    "@types/node": "25.9.2",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wxt": "0.20.26"
  },
  "prettier": {
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": false,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
